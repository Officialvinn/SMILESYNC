# NFR 1: HTTPS with TLS 1.3 only, in front of the API (and later the dashboard).
#
# Local demo: SITE_ADDRESS=localhost. Caddy issues a certificate from its own
# local CA automatically. On a cloud VM, set SITE_ADDRESS to the real domain
# and Caddy obtains a free Let's Encrypt certificate instead.
{$SITE_ADDRESS:localhost} {
	tls {
		protocols tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	encode zstd gzip

	# REST API: https://<site>/api/...
	handle_path /api/* {
		request_body {
			max_size 3MB
		}
		reverse_proxy api:3000
	}

	# Web dashboard (Sprint 3).
	handle {
		respond "SmileSync dashboard: coming in Sprint 3" 200
	}
}
