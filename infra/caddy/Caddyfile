# NFR 1: HTTPS with TLS 1.3 only, in front of the API and the dashboard.
#
# Local demo: SITE_ADDRESS=localhost. Caddy issues a certificate from its own
# local CA automatically. On a cloud VM, set SITE_ADDRESS to the real domain
# and Caddy obtains a free Let's Encrypt certificate instead.
{$SITE_ADDRESS:localhost} {
	tls {
		protocols tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	encode zstd gzip

	# REST API: https://<site>/api/...
	handle_path /api/* {
		request_body {
			max_size 3MB
		}
		reverse_proxy api:3000
	}

	# The CHW app for direct install: https://<site>/download/smilesync.apk
	# Files come from ./downloads on the server (not in git); see docs/DEPLOY.md.
	handle /download/* {
		root * /srv
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header Cache-Control "no-cache"
		file_server
	}

	# Web dashboard (FR 6-8): static files built by infra/caddy/Dockerfile.
	handle {
		root * /srv/web
		header {
			# Only our own scripts and styles; photos are shown from blob: URLs.
			Content-Security-Policy "default-src 'self'; img-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		# Hashed assets never change; the page itself is always re-checked.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
