{
  "name": "@smilesync/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SmileSync CHW app: offline registration, consent and oral image capture",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "npm run build -w @smilesync/shared && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smilesync/shared": "0.1.0",
    "bcryptjs": "3.0.3",
    "expo": "57.0.31",
    "expo-camera": "57.0.6",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-file-system": "57.0.7",
    "expo-image-manipulator": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.2.18"
  }
}
