{
  "expo": {
    "name": "SmileSync",
    "slug": "smilesync",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.smilesync.chw",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SmileSync uses the camera to take photos of a patient's teeth for a dentist to review."
      }
    },
    "android": {
      "package": "org.smilesync.chw",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SmileSync uses the camera to take photos of a patient's teeth for a dentist to review.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/withNetworkSecurity"
    ]
  }
}
