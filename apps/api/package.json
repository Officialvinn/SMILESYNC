{
  "name": "@smilesync/api",
  "version": "0.1.0",
  "private": true,
  "description": "SmileSync REST API (Express + Prisma + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/src/server.js",
    "build": "npm run build -w @smilesync/shared && prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "npm run build -w @smilesync/shared && prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@smilesync/shared": "0.1.0",
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
