# Copy to .env and fill in every value. Never commit .env.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"     (JWT_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (PATIENT_DATA_KEY)

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=smilesync
POSTGRES_PASSWORD=
POSTGRES_DB=smilesync
# Password for smilesync_app, the API's restricted runtime role
APP_DB_PASSWORD=

# --- API ---
# At least 32 characters
JWT_SECRET=
# 32 random bytes, base64. Encrypts patient names (NFR 1). Losing it makes them unreadable.
PATIENT_DATA_KEY=
BCRYPT_COST=12

# --- Running the API or tests on your machine (outside docker) ---
# Use the same passwords as above.
DATABASE_URL=postgresql://smilesync_app:APP_DB_PASSWORD@localhost:5432/smilesync
DATABASE_MIGRATION_URL=postgresql://smilesync:POSTGRES_PASSWORD@localhost:5432/smilesync
TEST_DATABASE_URL=postgresql://smilesync:POSTGRES_PASSWORD@localhost:5432/smilesync_test
TRUST_PROXY_HOPS=0

# --- Synthetic seed logins (local demo only) ---
# Password for admin1, dentist1, dentist2: at least 10 characters
SEED_PASSWORD=
# PIN for chw.narok1, chw.narok2, chw.marsabit1: exactly 6 digits
SEED_CHW_PIN=

# --- Caddy ---
# localhost for the local demo; a real domain on a cloud VM
SITE_ADDRESS=localhost
